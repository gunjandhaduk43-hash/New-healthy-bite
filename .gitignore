.env
.venv/
/vendor/
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep
cookies.txt

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Microsoft Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx
~$*.doc

# Temporary and scratch files
*.tmp
